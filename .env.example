# Django
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# OpenRouter via the OpenAI Python SDK
OPENROUTER_API_KEY=your_openrouter_api_key
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL=openai/gpt-4o-mini
OPENROUTER_APP_TITLE=English Practice Diagnostic
# Optional, but recommended by OpenRouter
OPENROUTER_REFERER=http://localhost:5170

# Writing mode
# The essay is measured locally first, so the model only scores it.
WRITING_AI_ENABLED=1
# Falls back to OPENROUTER_MODEL when unset.
OPENROUTER_WRITING_MODEL=
# Essays shorter than this are scored locally, with no model call.
WRITING_AI_MIN_WORDS=40
# Hard limits that keep one review cheap and bounded.
WRITING_MAX_ESSAY_WORDS=450
WRITING_MAX_OUTPUT_TOKENS=700
WRITING_AI_TIMEOUT=45
# Set either to 1 to force the regex analyser (useful for debugging).
WRITING_DISABLE_SPACY=0
WRITING_DISABLE_NLTK=0
